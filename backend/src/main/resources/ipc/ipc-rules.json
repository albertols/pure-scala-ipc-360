      "ipcRef": "", "wikiRef": "docs/ipc/transformations/joiner.md" },
    { "id": "IPC-TYP-JOINERINPUT-001", "severity": "error",
      "statement": "joiner input target name must be <joiner>.MASTER or <joiner>.DETAIL",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/xmltojson/recipe/transformation/AbstractTargetFactory.scala:88",
      "ipcRef": "", "wikiRef": "docs/ipc/transformations/joinerInput.md" },
    { "id": "IPC-TYP-UNION-001", "severity": "error",
      "statement": "union source must specify unionTables, and every fieldMapping entry must carry both origin and union",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractSource.scala:8-14",
      "ipcRef": "", "wikiRef": "docs/ipc/transformations/union.md" }
  ]
}
