      "ipcRef": "", "wikiRef": "docs/ipc/transformations/router.md" },
    { "id": "IPC-TYP-ROUTER-002", "severity": "error",
      "statement": "router groups may include at most one default group (default: true)",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractTarget.scala:47",
      "ipcRef": "", "wikiRef": "docs/ipc/transformations/router.md" },
    { "id": "IPC-TYP-ROUTER-003", "severity": "error",
      "statement": "router source must specify group, the upstream output group name it reads from",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractSource.scala:37",
      "ipcRef": "", "wikiRef": "docs/ipc/transformations/router.md" },
    { "id": "IPC-TYP-AGGREGATOR-001", "severity": "error",
      "statement": "aggregator target must specify groupByFields as an array",
