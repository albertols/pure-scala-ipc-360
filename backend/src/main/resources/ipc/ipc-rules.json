      "ipcRef": "", "wikiRef": "docs/ipc/rules.md#ipc-str-008" },
    { "id": "IPC-STR-009", "severity": "error",
      "statement": "every field must have a non-blank name",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/Recipe.scala:9",
      "ipcRef": "", "wikiRef": "docs/ipc/rules.md#ipc-str-009" },
    { "id": "IPC-TYP-REQUIRED-KEYS", "severity": "error",
      "statement": "no per-kind required key (per keySchema) is missing from a step target or source — the umbrella id the generic driver reports when it finds zero violations; each actual violation is reported under the specific IPC-TYP-<KIND>-NNN id from the key's ruleId",
      "parserRef": "backend/src/main/java/io/pure360/etl360/service/ipc/TypeShapeRules.java:81",
      "ipcRef": "", "wikiRef": "docs/ipc/rules.md#ipc-typ-required-keys" },
    { "id": "IPC-TYP-SOURCEQUALIFIER-001", "severity": "error",
