    "source:java": [
      { "key": "name", "parserType": "String", "required": true, "widget": "text" },
      { "key": "type", "parserType": "String", "required": true, "widget": "text" }
    ],
    "source:storedProcedure": [
      { "key": "name", "parserType": "String", "required": true, "widget": "text" },
      { "key": "type", "parserType": "String", "required": true, "widget": "text" }
    ]
  },
  "rules": [
    { "id": "IPC-STR-001", "severity": "error",
      "statement": "steps must be a non-empty array",
