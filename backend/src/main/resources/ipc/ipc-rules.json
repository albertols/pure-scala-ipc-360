      { "key": "type",   "parserType": "String",            "required": true, "widget": "text" },
      { "key": "fields", "parserType": "List[Field]",       "required": true, "widget": "fieldTable" },
      { "key": "groups", "parserType": "List[RouterGroup]", "required": true, "widget": "rowTable",
