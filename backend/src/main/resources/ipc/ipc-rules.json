      "ipcRef": "", "wikiRef": "docs/ipc/transformations/aggregator.md" },
    { "id": "IPC-TYP-NORMALIZER-001", "severity": "error",
      "statement": "normalizer target must specify normalizedFields as an array",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractTarget.scala:60",
      "ipcRef": "https://docs.informatica.com/integration-cloud/data-integration/current-version/transformations/normalizer-transformation.html",
      "wikiRef": "docs/ipc/transformations/normalizer.md" },
    { "id": "IPC-TYP-NORMALIZER-002", "severity": "error",
      "statement": "every normalized field's refSource must reference at least one input field",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractTarget.scala:76",
      "ipcRef": "https://docs.informatica.com/integration-cloud/data-integration/current-version/transformations/normalizer-transformation/normalized-fields/generated-keys.html",
      "wikiRef": "docs/ipc/transformations/normalizer.md" },
    { "id": "IPC-TYP-JAVA-001", "severity": "error",
      "statement": "java target must specify javaCode",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractTarget.scala:82",
      "ipcRef": "", "wikiRef": "docs/ipc/transformations/java.md" },
    { "id": "IPC-TYP-STOREDPROCEDURE-001", "severity": "error",
      "statement": "stored procedure target must specify procedureName",
      "parserRef": "parser/src/main/scala/io/pure360/ipc/model/recipe/AbstractTarget.scala:87",
      "ipcRef": "", "wikiRef": "docs/ipc/transformations/storedProcedure.md" },
    { "id": "IPC-TYP-JOINER-001", "severity": "error",
      "statement": "joiner source must specify joinerTables, joinerType and joinerCondition",
