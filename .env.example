# ETL 360 backend configuration (backend/src/main/resources/application.yml).
#
# Copy to `.env` (or export these in your shell) to override defaults locally.
# Relative paths are resolved against the auto-detected repo root (the first ancestor
# directory containing both `pom.xml` and `parser/`); absolute paths are taken as-is.
# None of these are secrets on their own, but real DWH_CONTROL/composer paths and real
# GCP project ids are treated as environment-specific, not committed.
#
# .env is the power-user tier — layering is defaults < config.json < .env < shell env
# for ETL360_* (ADR-0009: docs/adr/0009-config-json-entrypoint.md); most users want
# config.json instead (see README "Run the 360 suite on your own data").

# Corpus of IPC Powermart XML exports + generated recipe/DDL JSONs.
ETL360_CORPUS_ROOT=parser/src/main/resources/xmltobq

# Real DWH_CONTROL control-schema export. Optional and git-ignored; if absent, the
# backend falls back to the committed mock mirror under ETL360_MOCK_ROOT/DWH_CONTROL
# (see backend/src/main/resources/mock/DWH_CONTROL/README.md). Mode is reported by
# GET /api/config and GET /api/health as "real" | "mock" | "absent".
ETL360_DWH_CONTROL_ROOT=parser/src/main/resources/DWH_CONTROL

# Root of the committed mock-data mirror (DWH_CONTROL fallback, etc.).
ETL360_MOCK_ROOT=backend/src/main/resources/mock

# Composer (DBM Composer/scheduling) export root. Optional and git-ignored; if absent,
# the backend falls back to the committed mock tier under ETL360_MOCK_ROOT/composer
# (14 days of synthetic b15 job history), same as DWH_CONTROL. Mode is reported by
# GET /api/config and GET /api/health as "real" | "mock" | "absent"
# (DataRoots.java:45-51).
ETL360_COMPOSER_ROOT=parser/src/main/resources/composer

# GCP project id shown in the frontend and used to build Dataproc/Logging deep links.
ETL360_GCP_PROJECT=db-dev-example-project
# Example corp-style value (placeholder pattern only, not a real project):
# ETL360_GCP_PROJECT=db-prd-xxxx-project

# GCP region for Dataproc jobs/clusters.
ETL360_GCP_REGION=europe-southwest1
