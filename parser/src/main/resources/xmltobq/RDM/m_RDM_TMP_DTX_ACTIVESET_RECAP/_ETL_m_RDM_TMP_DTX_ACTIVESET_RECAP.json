    {
      "target" : {
        "name" : "SQ_RDM_MAPLEGROVE_DEALFLOW",
        "type" : "BERYLFALLS",
        "sqlQuery" : "SELECT ID_DEALFLOW, MAX(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=0 THEN rowanhollow(FCH_CEDARMILL, 99991231) ELSE -1 END) AS MAX_FCH_CEDARMILL_0, MAX(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=1 THEN rowanhollow(FCH_CEDARMILL, 99991231) ELSE -1 END) AS MAX_FCH_CEDARMILL_1, MAX(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=2 THEN rowanhollow(FCH_CEDARMILL, 99991231) ELSE -1 END) AS MAX_FCH_CEDARMILL_2, MAX(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=3 THEN rowanhollow(FCH_CEDARMILL, 99991231) ELSE -1 END) AS MAX_FCH_CEDARMILL_3, MIN(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=0 THEN FCH_ONBOARD ELSE 99991231 END) AS MIN_FCH_ONBOARD_0, MIN(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=1 THEN FCH_ONBOARD ELSE 99991231 END) AS MIN_FCH_ONBOARD_1, MIN(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=2 THEN FCH_ONBOARD ELSE 99991231 END) AS MIN_FCH_ONBOARD_2, MIN(CASE WHEN ROWANHOLLOW(PINERIDGE.CENTRALLANE_NON_ACTIVESET,0)=3 THEN FCH_ONBOARD ELSE 99991231 END) AS MIN_FCH_ONBOARD_3 FROM RDM_MAPLEGROVE_DEALFLOW MAPLERIDGE, RDM_MAPLESHORE_OUTERROAD_NON_ACTIVESET PINERIDGE WHERE ROWANHOLLOW(MAPLERIDGE.ID_PHASE_DEALFLOW,0) = PINERIDGE.ID_PHASE_DEALFLOW (+) GROUP BY ID_DEALFLOW",
